<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Password Changed</title>
</head>
<body style="margin:0; padding:0; background-color:#F1F3F8; font-family:Segoe UI, Helvetica, Arial, sans-serif;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F1F3F8; padding:40px 16px;">
    <tr>
      <td align="center">

        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width:480px; width:100%; background-color:#FFFFFF; border-radius:16px; overflow:hidden; box-shadow:0 2px 10px rgba(15,23,42,0.06);">

          <!-- Top bar -->
          <tr>
            <td style="background-color:#0B1220; padding:22px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="color:#F1F3F8; font-size:15px; font-weight:600; letter-spacing:0.5px;">
                    &#9989; Password Changed
                  </td>
                  <td align="right">
                    <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:#2DD4BF;"></span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Success icon -->
          <tr>
            <td align="center" style="padding:32px 32px 8px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="width:64px; height:64px; border-radius:50%; background-color:#ECFDF5;">
                    <span style="font-size:30px; line-height:64px;">&#128274;</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td align="center" style="padding:16px 32px 8px 32px;">
              <p style="margin:0 0 6px 0; color:#0B1220; font-size:20px; font-weight:700;">
                Hi <%= name %>, your password was changed
              </p>
              <p style="margin:0; color:#64748B; font-size:14px; line-height:20px;">
                This is a confirmation that the password for your account was successfully updated just now.
              </p>
            </td>
          </tr>

          <!-- Warning note -->
          <tr>
            <td style="padding:28px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FFF8EB; border-radius:10px;">
                <tr>
                  <td style="padding:12px 16px; color:#92650B; font-size:13px; line-height:18px;">
                    &#9888;&#65039; If you didn't make this change, please reset your password immediately and contact support — your account may be at risk.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 32px;">
              <hr style="border:none; border-top:1px solid #EDF0F5; margin:0;">
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:20px 32px 30px 32px;">
              <p style="margin:0; color:#94A3B8; font-size:12px; line-height:18px;">
                Sent automatically — please don't reply to this email.<br>
                &copy; <span id="year">2026</span> Your Company. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
