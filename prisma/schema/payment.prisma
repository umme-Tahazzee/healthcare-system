model Payment{
     id String @id @default(uuid())
     status PaymentStatus @default(UNPAID)
     
     amount Decimal @db.Decimal(10,2)
     currency String @default("BDT")
     
     paymentGateway String @default("bkash")
     marchentInvoiceNumber String @unique //apoinment id

     bkashPaymentId String? @unique
     bkashTrxId String?
     payerReference String?
     paidAt String?

     gatewayResponse Json?
     refundTrxId String?
     refundAmount Decimal? @db.Decimal(10,2)
     refundAt DateTime?
     
     appointmentId String @unique
     appointment Appoinment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
     
     createAt DateTime @default(now())
     updatedAt DateTime @updatedAt

     @@map("payments")
}